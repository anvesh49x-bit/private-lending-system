generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InterestFrequency {
  MONTHLY
  YEARLY
  CUSTOM_DATE_RANGE
}

enum InterestValueType {
  PERCENTAGE
  RUPEES
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum PaymentStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ExcessStatus {
  AVAILABLE
  APPLIED
  REFUNDED
}

enum ReminderMode {
  DEFAULT_DUE_DATE
  CUSTOM
}

enum ReminderType {
  PAYMENT_DUE
  LOAN_END_DATE
  CUSTOM
}

enum ReminderChannel {
  WHATSAPP
  SMS
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model LoanReminder {
  id     String @id @default(uuid())
  loanId String

  type    ReminderType
  channel ReminderChannel
  message String?         @db.Text

  mode          ReminderMode? // Keep for backwards compatibility if needed
  scheduledDate DateTime
  status        ReminderStatus @default(PENDING)

  sentAt       DateTime?
  errorDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([scheduledDate])
  @@index([status])
}

model Borrower {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans    Loan[]
  payments Payment[]
  excesses ExcessBalance[]
}

model Loan {
  id         String @id @default(uuid())
  borrowerId String

  principalAmount Decimal @db.Decimal(15, 2)

  interestFrequency InterestFrequency
  interestValueType InterestValueType
  interestRate      Decimal           @db.Decimal(15, 2)

  startDate              DateTime
  endDate                DateTime?
  collectionReminderDate DateTime?

  status LoanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]
  reminders   LoanReminder[]

  @@index([borrowerId])
  @@index([status])
}

model Payment {
  id         String @id @default(uuid())
  borrowerId String

  amount      Decimal       @db.Decimal(15, 2)
  paymentDate DateTime      @default(now())
  status      PaymentStatus @default(COMPLETED)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]
  excesses    ExcessBalance[]

  @@index([borrowerId])
  @@index([status])
}

model PaymentAllocation {
  id String @id @default(uuid())

  paymentId String
  loanId    String

  amount Decimal @db.Decimal(15, 2)

  // Split each payment clearly into:
  // interest paid + principal paid
  interestAmount  Decimal @db.Decimal(15, 2)
  principalAmount Decimal @db.Decimal(15, 2)

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  loan    Loan    @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([loanId])
}

model ExcessBalance {
  id String @id @default(uuid())

  borrowerId String
  paymentId  String

  amount Decimal      @db.Decimal(15, 2)
  status ExcessStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower Borrower @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([borrowerId])
  @@index([paymentId])
}
